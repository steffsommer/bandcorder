{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.23",
    "nodejs@22",
    "flutter338@latest",
    "pkg-config",
    "gtk3",
    "webkitgtk_4_1",
    "mesa",
    "github:NixOS/nixpkgs/nixos-24.05#pkgsCross.mingwW64.buildPackages.gcc"
  ],
  "env": {
    "WAILS_VERSION": "v2.10.2",
    "GOBIN": "$DEVBOX_PROJECT_ROOT/.devbox/gobin",
    "PATH": "$DEVBOX_PROJECT_ROOT/.devbox/gobin:$PATH",
    "__EGL_VENDOR_LIBRARY_FILENAMES": "$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/share/glvnd/egl_vendor.d/50_mesa.json",
    "EGL_PLATFORM": "surfaceless",
    "WEBKIT_DISABLE_DMABUF_RENDERER": "1"
  },
  "shell": {
    "init_hook": [
      "wails version 2>/dev/null | grep -q \"$WAILS_VERSION\" || go install github.com/wailsapp/wails/v2/cmd/wails@\"$WAILS_VERSION\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
